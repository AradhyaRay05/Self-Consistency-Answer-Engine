# ── Self-Consistency Answer Engine — environment configuration ──
# 1. Copy this file to .env
# 2. Fill in your keys (never commit .env — it is gitignored)
#
# Any provider left empty runs in MOCK mode (yellow "mock" badge in the UI),
# so the app demos end-to-end without keys.
#
# Each slot supports BASE_URL + MODEL overrides, so any OpenAI-compatible
# gateway can be used behind the scenes while the UI keeps the
# ChatGPT / Claude / Gemini branding.

# ── OpenAI slot (ChatGPT card) ────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.5

# ── Anthropic slot (Claude card) ────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4.6

# ── Final Synthesized Answer evaluator ────────────────────────
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=https://api.anthropic.com/v1
EVALUATOR_MODEL=claude-haiku-4

# ── Google slot (Gemini card) ─────────────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
