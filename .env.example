# ── Self-Consistency Answer Engine — environment configuration ──
# 1. Copy this file to .env
# 2. Fill in your keys (never commit .env — it is gitignored)
#
# Any provider left empty runs in MOCK mode (yellow "mock" badge in the UI),
# so the app demos end-to-end without keys.
#
# Each slot supports BASE_URL + MODEL overrides, so any OpenAI-compatible
# gateway (OpenRouter, Groq, Azure OpenAI, aicredits.in, local LLMs) can be
# used behind the scenes while the UI keeps the ChatGPT / Claude / Gemini branding.

# ── OpenAI slot (ChatGPT card) ────────────────────────────
# Default (direct OpenAI):
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o
# Example (Groq):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ── Anthropic slot (Claude card + Final Synthesized Answer evaluator) ──
# Project requirement: evaluator is Claude (shown as Claude in the UI).
# Default direct Anthropic:
#   ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
#   ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Final Synthesized Answer evaluator (shown as Claude in UI) ──
# This model compares all three candidate answers and synthesizes the final output.
# Per project requirements the UI shows "Claude" as the evaluator — use a Haiku model here.
# Real deployments can point this at any OpenAI-compatible gateway behind the scenes.
EVALUATOR_API_KEY=
EVALUATOR_BASE_URL=https://api.anthropic.com/v1
EVALUATOR_MODEL=claude-3-5-haiku-20241022

# ── Google slot (Gemini card) ─────────────────────────────
# Default (direct Google Generative Language):
#   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   GEMINI_MODEL=gemini-2.0-flash
# Example (gateway):
#   GEMINI_BASE_URL=https://aicredits.in/v1
#   GEMINI_MODEL=google/gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
